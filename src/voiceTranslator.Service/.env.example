# DeepL API — get free key at https://www.deepl.com/pro-api
DEEPL_API_KEY=your-deepl-api-key-here

# LibreTranslate fallback (self-hosted)
LIBRETRANSLATE_URL=http://localhost:5000

# Language defaults
SOURCE_LANGUAGE=ES
TARGET_LANGUAGE=EN

# Whisper model: base | small (base recommended for CPU)
WHISPER_MODEL=base

# TTS voices
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_ES=es-CO-SalomeNeural
